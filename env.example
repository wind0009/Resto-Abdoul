# Copier vers .env en local (ne pas committer .env).
# Sur Netlify : Site settings → Environment variables (même noms, préfixe VITE_ obligatoire).

# Supabase (menu + temps réel)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase (menu Firestore, optionnel si tu utilises aussi Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
